# AI Learning Memory OS — 环境变量模板（DEVOPS-02）
# 复制为 .env 后填写；本文件只含占位符，禁止填入任何真实密钥。
# ---------------------------------------------------------------------------
# 密钥管理规则（对应非功能需求「安全」与架构 §8）：
#   1. 密钥只存 .env / 本机密钥文件 / 进程环境变量；.env 已被 .gitignore 排除，绝不入库、不入 Git。
#   2. 网站保存的用户级集成凭据在数据库中存为密文。服务器密钥与数据库备份分别保管。
#   3. 缺失必需项时服务/脚本必须明确报错（CONFIG_MISSING），禁止静默降级为 Mock / 假数据。
#   4. 所有外部账号 / API Key / 付费调用须用户明确授权；AI_BILLING_APPROVED 未为 true 不得计费。
# ---------------------------------------------------------------------------
# 【启动必需】start-*.ps1 / run-worker.ps1 / backup/restore 会硬校验以下两项，
#            缺失或仍为占位符即拒绝启动（scripts/lib/common.ps1: Assert-RequiredEnv）。
#   DATABASE_URL   PostgreSQL 连接串，须由用户确认（BLK-05）；禁止猜测本机 5432 未知实例凭据
#   SECRET_KEY     JWT 签名和集成凭据加密派生的服务器密钥，使用至少 32 字符的随机值
# 【按需必需】对应功能启用时校验，未配置明确报错而非假数据：
#   Notion 同步:   NOTION_API_TOKEN + NOTION_DATABASE_IDS（BLK-01）
#   LLM 调用:      AI_API_KEY + AI_BILLING_APPROVED=true（BLK-02）
#   推送:          WECHAT_ENABLED=true + WECHAT_CHANNEL + 对应渠道凭据（BLK-03/04）
# ---------------------------------------------------------------------------
# 所有配置环境变量化，不写死 Windows 路径 / 盘符（FR-12）；Linux 迁移仅替换本文件即可。

# ============ 应用 ============
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# 所有时间以 UTC 存储、带时区（业务侧统一 UTC）
TZ=UTC
# ASGI 入口，可由 Backend Agent 调整或由 start-backend.ps1 -AppModule 覆盖
UVICORN_APP=app.main:app
# 后台任务业务 CLI 入口，由 Backend / AI / Notification Agent 交付
WORKER_MODULE=app.worker

# ============ 前端（端口/基址全部环境变量化）============
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3030
# Next.js forwards same-origin /api/v1 requests to this backend.
BACKEND_API_URL=http://127.0.0.1:8000
# 学习者网站构建时设置的独立管理端入口。
NEXT_PUBLIC_ADMIN_APP_URL=http://127.0.0.1:3001
# 管理端服务端读取。HTTPS 正式部署须设置 ADMIN_PUBLIC_ORIGIN 和 ADMIN_COOKIE_SECURE=true。
ADMIN_BACKEND_URL=http://127.0.0.1:8000
ADMIN_PUBLIC_ORIGIN=
ADMIN_COOKIE_SECURE=false
# Used for links inside review emails.
PUBLIC_APP_URL=http://127.0.0.1:3030

# ============ 数据库（PostgreSQL；连接串须由用户确认，禁止猜测）============
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# 说明：本机 5432 有未知实例监听，凭据未确认前不得尝试连接（BLK-05）。
# 可选：pg_dump / pg_restore 不在 PATH 时，用以下两项指定客户端工具完整路径（备份/恢复脚本用）
PG_DUMP_PATH=
PG_RESTORE_PATH=

# ============ 安全 ============
SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ Notion（待用户授权 BLK-01）============
NOTION_API_TOKEN=
NOTION_API_VERSION=2022-06-28
NOTION_DATABASE_IDS=
NOTION_SYNC_INTERVAL_MINUTES=60

# ============ AI Provider（待用户授权 BLK-02）============
AI_PROVIDER=deepseek
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
# 是否允许产生计费调用：用户明确授权后才可设为 true
AI_BILLING_APPROVED=false
BACKGROUND_TASKS_ENABLED=false

# 管理员备份默认停用。启用需将两项设为服务器上的绝对路径，目录应为已创建的私有目录。
ADMIN_BACKUP_DIRECTORY=
ADMIN_PG_DUMP_PATH=

# ============ 调度 ============
SCHEDULER_STRATEGY=fsrs
EBBINGHAUS_INTERVALS_DAYS=1,2,4,7,15,30
FSRS_TARGET_RETENTION=0.9
DAILY_REVIEW_LIMIT=30
# 后台任务每日触发时刻（UTC，HH:mm）；被 run-worker.ps1 -Loop 与任务计划/cron 共同使用
DAILY_TASKS_AT=00:05
DAILY_DIGEST_AT=08:00

# ============ 通知渠道（待用户授权 BLK-03 / BLK-04）============
# 个人微信无官方主动推送 API；请选择一种授权渠道：
# wecom_app | wechat_official_account | third_party_push | wecom_webhook
WECHAT_CHANNEL=
WECHAT_ENABLED=false

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_WEBHOOK_URL=

DINGTALK_WEBHOOK_URL=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Server酱 / PushPlus 等第三方微信推送（如选 third_party_push）
THIRD_PARTY_PUSH_TOKEN=

NOTIFY_MAX_RETRIES=3
NOTIFY_RETRY_BACKOFF_SECONDS=60
